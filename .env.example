DB_USERNAME=root
DB_PASSWORD=replace-with-a-strong-database-password
# Local Docker testing (NOT localhost - use host.docker.internal):
# DB_URL=jdbc:mysql://host.docker.internal:3307/loganalyzer
#
# Production RDS:
# DB_URL=jdbc:mysql://<rds-endpoint>:3306/loganalyzer

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRATION=86400000
OPENAI_API_KEY=replace-with-your-openai-api-key
CORS_ALLOWED_ORIGINS=http://localhost:4200
STORAGE_BASE_PATH=/app/uploads
FLYWAY_BASELINE_ON_MIGRATE=false
ACTUATOR_HEALTH_DETAILS=never
APP_LOG_LEVEL=INFO
SQL_LOG_LEVEL=WARN
