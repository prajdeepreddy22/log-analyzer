# Server
PORT=8080

# Database
DB_URL=jdbc:mysql://localhost:3306/log_analyzer?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=replace-with-your-database-password

# Authentication
# Use a randomly generated value with at least 32 characters.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# AI
OPENAI_API_KEY=replace-with-your-openai-api-key

# Frontend origin. Separate multiple origins with commas.
CORS_ALLOWED_ORIGINS=http://localhost:4200

# File storage
STORAGE_BASE_PATH=uploads

# Production defaults
APP_LOG_LEVEL=INFO
SQL_LOG_LEVEL=WARN
ACTUATOR_HEALTH_DETAILS=never
