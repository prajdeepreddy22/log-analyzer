# MySQL JDBC connection URL used by the backend.
DB_URL=jdbc:mysql://localhost:3306/log_analyzer?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# Database username.
DB_USERNAME=root

# Database password.
DB_PASSWORD=your-db-password-here

# Secret key used to sign JWT tokens. Must be at least 32 characters.
JWT_SECRET=your-minimum-32-character-secret-key-here

# JWT token expiration time in milliseconds.
JWT_EXPIRATION=86400000

# OpenAI API key used for AI analysis and chat.
OPENAI_API_KEY=your-openai-api-key-here

# Allowed frontend origins for CORS.
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Local directory used to store uploaded files.
STORAGE_BASE_PATH=uploads

# Whether Flyway should baseline an existing database schema.
FLYWAY_BASELINE_ON_MIGRATE=false

# Controls how much detail the actuator health endpoint returns.
ACTUATOR_HEALTH_DETAILS=never

# Application package logging level.
APP_LOG_LEVEL=INFO

# Hibernate SQL logging level.
SQL_LOG_LEVEL=WARN
